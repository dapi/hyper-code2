#!/bin/sh
# Validate the interpreter before Bun evaluates application code.  `env bun`
# in a shebang cannot do that: it has already selected and started Bun by then.
set -eu

bun_bin="${BUN_BIN:-bun}"
required_bun_version='1.3.13'

if ! bun_version="$("$bun_bin" --version 2>/dev/null)"; then
    printf '%s\n' "hcode: unable to run Bun via $bun_bin." >&2
    exit 1
fi

version_is_supported() {
    version=$1
    major=${version%%.*}
    rest=${version#*.}
    [ "$rest" != "$version" ] || return 1
    minor=${rest%%.*}
    rest=${rest#*.}
    [ "$rest" != "$minor" ] || return 1
    # POSIX bracket negation is `!`; `^` is not portable to dash (Ubuntu's
    # /bin/sh) and caused supported Bun versions to be rejected in CI.
    patch=${rest%%[!0-9]*}
    [ -n "$patch" ] || return 1
    case "$major.$minor.$patch" in
        *[!0-9.]* | '') return 1 ;;
    esac
    [ "$major" -gt 1 ] \
        || { [ "$major" -eq 1 ] && [ "$minor" -gt 3 ]; } \
        || { [ "$major" -eq 1 ] && [ "$minor" -eq 3 ] && [ "$patch" -ge 13 ]; }
}

if ! version_is_supported "$bun_version"; then
    printf '%s\n' "hcode: Bun >= $required_bun_version is required (found $bun_version via $bun_bin)." >&2
    printf '%s\n' 'Install a supported Bun, for example: mise use -g bun@1.3.14' >&2
    exit 1
fi

script_path=$0

case "$script_path" in
    */*) ;;
    *) script_path=$(command -v "$script_path") ;;
esac

# Package managers expose `bin` entries as symlinks. Resolve each link before
# locating the TypeScript entrypoint, including relative links used by npm.
while [ -L "$script_path" ]; do
    link_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
    link_target=$(readlink "$script_path")
    case "$link_target" in
        /*) script_path=$link_target ;;
        *) script_path=$link_dir/$link_target ;;
    esac
done

script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
exec "$bun_bin" "$script_dir/script/hcode.entry.ts" "$@"
